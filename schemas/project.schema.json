{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oneco:schema:project:1",
  "title": "OneCo project metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "state",
    "current_spec",
    "current_task",
    "latest_checkpoint"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^PROJ-[0-9]{3,}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "state": {
      "enum": [
        "registered",
        "shaping",
        "ready",
        "active",
        "blocked_external",
        "archived"
      ]
    },
    "current_spec": { "type": ["string", "null"] },
    "current_task": { "type": ["string", "null"] },
    "latest_checkpoint": { "type": ["string", "null"] }
  }
}
