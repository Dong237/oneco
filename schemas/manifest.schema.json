{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oneco:schema:manifest:2",
  "title": "OneCo company manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_name",
    "language",
    "provider",
    "model",
    "desktop",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "company_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "language": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cockpit", "executives", "owners"],
      "properties": {
        "cockpit": { "const": "macos-webview" },
        "executives": { "const": "ghostty" },
        "owners": { "const": "tmux" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
