{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oneco:schema:blocker-resolution:1",
  "title": "OneCo Owner blocker resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution_id",
    "blocker_id",
    "project_id",
    "resolved_by",
    "recorded_session_id",
    "recorded_epoch",
    "checkpoint_id",
    "evidence",
    "created_at"
  ],
  "properties": {
    "resolution_id": {"type": "string", "minLength": 1},
    "blocker_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^PROJ-[0-9]{3,}$"},
    "resolved_by": {"type": "string", "minLength": 1},
    "recorded_session_id": {"type": ["string", "null"], "minLength": 1},
    "recorded_epoch": {"type": ["integer", "null"], "minimum": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
