{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oneco:schema:checkpoint:1",
  "title": "OneCo project checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "project_id",
    "spec_id",
    "task_id",
    "result",
    "commit",
    "key_files",
    "verification",
    "spec_deviation",
    "complexity_change",
    "dependency_change",
    "risk_or_blocker",
    "next_task",
    "reuse_candidate",
    "created_at"
  ],
  "properties": {
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "pattern": "^PROJ-[0-9]{3,}$" },
    "spec_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "result": { "type": "string", "minLength": 1 },
    "commit": { "type": ["string", "null"] },
    "key_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).*$"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "spec_deviation": { "type": "string" },
    "complexity_change": { "type": "string" },
    "dependency_change": { "type": "string" },
    "risk_or_blocker": { "type": "string" },
    "next_task": { "type": "string", "minLength": 1 },
    "reuse_candidate": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
