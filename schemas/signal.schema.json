{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oneco:schema:signal:1",
  "title": "OneCo market Signal",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "title", "summary", "status", "assigned_by", "source_ids", "linked_bet_ids", "created_at"],
  "properties": {
    "signal_id": {"type": "string", "pattern": "^SIG-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["recorded", "assigned", "investigating", "linked", "closed"]},
    "assigned_by": {"const": "BOARD"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"}},
    "linked_bet_ids": {"type": "array", "items": {"type": "string", "pattern": "^BET-[0-9]{4,}$"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
